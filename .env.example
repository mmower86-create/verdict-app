# Server env vars (server/.env)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
PORT=3001

# URL the client runs on -- used for CORS and Stripe redirect URLs
CLIENT_URL=http://localhost:5173

# Supabase (server-side only -- the service role key bypasses RLS, never expose it)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
# Price IDs from the Stripe dashboard:
STRIPE_PRICE_FOUNDER=price_founder_pro_monthly      # Pro at founder pricing (first 100 only)
STRIPE_PRICE_STANDARD=price_standard_pro_monthly    # Pro at standard pricing (after founder cap)
STRIPE_PRICE_BUSINESS=price_business_monthly        # Business tier

# Client env vars (client/.env)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
