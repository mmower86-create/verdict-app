# Server env vars. The root .env.example is the authoritative, commented list;
# this file must stay in sync with it. `npm run audit --prefix server` fails if
# either one omits a variable the code actually reads.

CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
PORT=3001

# Exact origin the browser loads the client from. Used for BOTH the CORS allow
# list and the Stripe success/cancel redirects. Exact string match: a trailing
# slash or a scheme mismatch blocks every browser call in production.
CLIENT_URL=http://localhost:5173

# Supabase. The service role key bypasses RLS -- server-side only, never shipped
# to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# Signing secret for the endpoint at /api/stripe/webhook. Regenerated by Stripe
# whenever the endpoint URL changes.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
# Price IDs from the Stripe dashboard.
STRIPE_PRICE_FOUNDER=price_founder_pro_monthly     # Pro, founder pricing (first 100 only)
STRIPE_PRICE_STANDARD=price_standard_pro_monthly   # Pro, standard pricing
# REQUIRED. If this is unset, /api/checkout refuses Business with a 503 AND the
# subscription.updated webhook silently resolves every plan switch to 'pro',
# dropping paying Business customers to the 15/mo cap. See audit invariant B6.
STRIPE_PRICE_BUSINESS=price_business_monthly
